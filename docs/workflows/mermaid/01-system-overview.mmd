classDef merchant fill:#ffe6d5,stroke:#b4744d,color:#35291f
classDef admin fill:#e9eff9,stroke:#6e86a2,color:#273447
classDef terminal fill:#e6f3e9,stroke:#64866b,color:#263d2b
