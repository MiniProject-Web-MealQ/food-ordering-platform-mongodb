PORT=5000
MONGO_URI=mongodb://127.0.0.1:27018/mealq
FRONTEND_URL=http://localhost:5173
# Use 2 only behind the deployed cloudflared -> nginx chain; keep API private.
TRUST_PROXY_HOPS=1
# Development also accepts loopback frontend ports. Production uses only FRONTEND_URL.
SESSION_SECRET=change-this-for-real-deployment
# Demo PromptPay + self-service demo Wallet topups, including NODE_ENV=production.
# Set wallet to disable simulated external payments and self-service demo topups.
PAYMENT_MODE=demo

# Optional Google OAuth (register this exact callback URL with Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# SMTP is required for password signup OTP. Google Login is configured separately.
# Gmail: smtp.gmail.com, port 587, secure=false; use a Google App Password.
# For Gmail, SMTP_USER and the email in SMTP_FROM should be the same sender.
# Password-reset email uses this connection too; development also returns a local reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
