PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mealq
FRONTEND_URL=http://localhost:5173
# Development also accepts loopback frontend ports. Production uses only FRONTEND_URL.
SESSION_SECRET=change-this-for-real-deployment

# Optional Google OAuth (register this exact callback URL with Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Optional SMTP for password reset email; development also returns a local reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
